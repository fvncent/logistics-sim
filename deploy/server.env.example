# Copy to the repo root as .env on the server (chmod 600). Never commit .env.
#   cp deploy/server.env.example .env && chmod 600 .env && $EDITOR .env
COMPOSE_FILE=compose.yaml:compose.server.yaml:compose.server-data.yaml
COMPOSE_PROFILES=core,sim

# Image tag built on the server (git short sha of the deployed commit).
VLSIM_IMAGE_TAG=CHANGE_ME

# Postgres password: letters and digits only (it is embedded in a DSN URL).
#   openssl rand -hex 24
TMS_PG_PASSWORD=CHANGE_ME

# Data directories on the 2 TB disk (postgres/ redpanda/ groundtruth/ state/ below this).
DATA_ROOT=/srv/vlsim

# Where published ports listen. 127.0.0.1 = only this host (default; reach it from your laptop
# with `ssh -L` or `tailscale serve`). To bind the Tailscale interface instead, put this host's
# 100.x.y.z address here (see README: Tailscale binding caveat at boot). Never 0.0.0.0.
BIND_ADDR=127.0.0.1
TMS_PG_PORT=55432
REDPANDA_PORT=19092
TMS_API_PORT=8000
SIM_HTTP_PORT=8081
# Address Kafka clients are told to connect to (must be reachable from the client). Use the IPv4
# literal, not "localhost": Ubuntu resolves localhost to ::1 first, but ports publish on IPv4.
REDPANDA_ADVERTISE_HOST=127.0.0.1

# Simulator
VLSIM_PRESET=m
VLSIM_SPEED=1
VLSIM_RUN_ID=server-1

# Host-side tools (alembic, vlsim reconcile, make soak) talk to the published ports:
VLSIM_TMS_DSN=postgresql+psycopg://vlsim:CHANGE_ME@127.0.0.1:55432/tms
